# String de conexão do MongoDB (Atlas ou local)
DATABASE_URL="mongodb+srv://usuario:senha@cluster.mongodb.net/sistema-oficina?retryWrites=true&w=majority"

# Segredo usado para assinar os tokens JWT - troque por um valor aleatório forte
JWT_SECRET="troque-por-um-segredo-bem-forte-aqui"

# Porta em que a API vai rodar
PORT=3333

# Origem(ns) permitidas para CORS (separadas por vírgula). Use * em dev.
CORS_ORIGIN=http://localhost:5173
