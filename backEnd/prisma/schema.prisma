generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Cargo {
  ADMIN
  MECANICO
  ATENDENTE
}

enum StatusOS {
  ABERTA
  DIAGNOSTICO
  AGUARDANDO_PECA
  EM_EXECUCAO
  PRONTA
  ENTREGUE
  CANCELADA
}

enum FormaPagamento {
  DINHEIRO
  CARTAO_CREDITO
  CARTAO_DEBITO
  PIX
  FIADO
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

enum TipoTransacao {
  RECEITA
  DESPESA
}

enum StatusAgendamento {
  AGENDADO
  CONFIRMADO
  CANCELADO
  CONCLUIDO
}

model Usuario {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nome      String
  email     String   @unique
  senha     String
  cargo     Cargo    @default(ATENDENTE)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Cliente {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  nome         String
  cpfCnpj      String         @unique
  telefone     String
  email        String?
  endereco     Json
  createdAt    DateTime       @default(now())
  motos        Moto[]
  ordens       OrdemServico[] @relation("ClienteOrdens")
  agendamentos Agendamento[]  @relation("ClienteAgendamentos")
}

model Moto {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  clienteId    String         @db.ObjectId
  cliente      Cliente?       @relation(fields: [clienteId], references: [id])
  marca        String
  modelo       String
  placa        String         @unique
  ano          Int
  cor          String
  cilindrada   Int
  createdAt    DateTime       @default(now())
  ordens       OrdemServico[] @relation("MotoOrdens")
  agendamentos Agendamento[]  @relation("MotoAgendamentos")
}

model OrdemServico {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  numero    Int     @unique
  clienteId String  @db.ObjectId
  cliente   Cliente @relation("ClienteOrdens", fields: [clienteId], references: [id])
  motoId    String  @db.ObjectId
  moto      Moto    @relation("MotoOrdens", fields: [motoId], references: [id])

  quilometragem Int
  problema      String
  diagnostico   String?
  status        StatusOS @default(ABERTA)

  servicos Json
  pecas    Json

  total          Float
  formaPagamento FormaPagamento?
  valorPago      Float           @default(0)
  troco          Float           @default(0)

  dataEntrada  DateTime  @default(now())
  dataPrevisao DateTime?
  dataSaida    DateTime?

  observacoes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Peca {
  id               String                @id @default(auto()) @map("_id") @db.ObjectId
  nome             String
  codigo           String                @unique
  categoria        String
  quantidade       Int                   @default(0)
  quantidadeMinima Int                   @default(2)
  precoCusto       Float
  precoVenda       Float
  fornecedor       String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  movimentacoes    MovimentacaoEstoque[]
}

model MovimentacaoEstoque {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  pecaId         String           @db.ObjectId
  peca           Peca             @relation(fields: [pecaId], references: [id])
  tipo           TipoMovimentacao
  quantidade     Int
  motivo         String
  ordemServicoId String?          @db.ObjectId
  createdAt      DateTime         @default(now())
}

model Transacao {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  tipo           TipoTransacao
  categoria      String
  descricao      String
  valor          Float
  formaPagamento FormaPagamento?
  ordemServicoId String?         @db.ObjectId
  data           DateTime        @default(now())
  createdAt      DateTime        @default(now())
}

model Agendamento {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  clienteId   String            @db.ObjectId
  cliente     Cliente           @relation("ClienteAgendamentos", fields: [clienteId], references: [id])
  motoId      String?           @db.ObjectId
  moto        Moto?             @relation("MotoAgendamentos", fields: [motoId], references: [id])
  dataHora    DateTime
  servico     String
  status      StatusAgendamento @default(AGENDADO)
  observacoes String?
  createdAt   DateTime          @default(now())
}
